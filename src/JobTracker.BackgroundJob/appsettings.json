{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "JobsDatabase": "Host=localhost;Port=5432;Database=jobtracker;Username=jobtracker;Password=jobtracker_dev_password;SSL Mode=Disable"
  },
  "OutboxDispatch": {
    "CronExpression": "* * * * *",
    "BatchSize": 50,
    "MaxBatchesPerRun": 5
  },
  "Notifications": {
    "SenderEmail": "no-reply@jobtracker.local",
    "SenderName": "JobTracker",
    "SendGridApiKey": null,
    "CustomerEmails": {},
    "FallbackEmail": null
  }
}

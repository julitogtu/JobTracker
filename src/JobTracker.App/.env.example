# Base URL of the JobTracker .NET API.
# The default (https) launch profile binds BOTH https://localhost:7163 and http://localhost:5238,
# and redirects 5238 -> 7163, so HTTPS is used either way. `npm run dev` enables Node's
# --use-system-ca so the ASP.NET dev certificate is trusted -- see README.
# For an HTTP-only setup, run the API with `--launch-profile http` and use port 5238 here.
JOBTRACKER_API_URL=https://localhost:7163

# API version sent as the x-api-version header (the API defaults to 1.0).
JOBTRACKER_API_VERSION=1.0

# Organization scope for the demo UI. Every API read/write is tenant-scoped by this id.
JOBTRACKER_ORGANIZATION_ID=8f6c1b52-1f3d-4a2e-9c77-2b1d5f0e4a10
